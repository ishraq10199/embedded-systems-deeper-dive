# ==============================================================================
# .gitignore for repositories containing nested STM32CubeIDE projects
# ==============================================================================


# ------------------------------------------------------------------------------
# STM32CubeIDE / Eclipse Build Artifacts
# ------------------------------------------------------------------------------

# Build output directories (Debug, Release, or custom configurations)
**/Debug/
**/Release/
**/*.elf
**/*.bin
**/*.hex
**/*.map
**/*.lst
**/*.su
**/*.d
**/*.cyclo
**/*.o
**/*.a

# If there are any .asm files produced manually for debugging
**/*.asm

# Linker output
**/*.ld.bak


# ------------------------------------------------------------------------------
# STM32CubeIDE / Eclipse IDE Files
# ------------------------------------------------------------------------------

# Eclipse project metadata (auto-generated, machine-specific)
**/.cproject
**/.mxproject

# STM32CubeIDE settings folder (contains machine-specific launch configs, etc.)
**/.settings/

# Language settings (auto-generated by indexer)
**/.csettings

# STM32CubeMX backup files
**/*.bak


# ------------------------------------------------------------------------------
# STM32CubeMX Generated File Tracking
# (Keep: .ioc, Src/, Inc/, Core/, Drivers/ — these are source-controlled)
# ------------------------------------------------------------------------------

# CubeMX temp/log files
**/STM32CubeMX_upgrade*.log
**/MXTmpFiles/


# ------------------------------------------------------------------------------
# Eclipse Workspace (if stored inside the repo — generally avoid this)
# ------------------------------------------------------------------------------

**/.metadata/
**/RemoteSystemsTempFiles/
**/*.launch


# ------------------------------------------------------------------------------
# Compiler / Toolchain Artifacts
# ------------------------------------------------------------------------------

# GCC dependency files
**/*.d

# Preprocessed files
**/*.i
**/*.ii
**/*.s

# Static library archives
**/*.a


# ------------------------------------------------------------------------------
# Debugger / OpenOCD / ST-Link
# ------------------------------------------------------------------------------

**/*.svd.bak
**/openocd.log
**/*.jlink


# ------------------------------------------------------------------------------
# OS & Editor Noise
# ------------------------------------------------------------------------------

# macOS
.DS_Store
**/.DS_Store
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# VS Code (if used alongside CubeIDE)
**/.vscode/


# JetBrains / CLion
**/.idea/
**/*.iml


# ------------------------------------------------------------------------------
# Doxygen
# ------------------------------------------------------------------------------

**/html/
**/latex/
**/doxygen_output/

# ------------------------------------------------------------------------------
# Custom added
# ------------------------------------------------------------------------------

STM32CubeF4/
**/*.code-workspace
**/.cache/
**/Archive.zip
